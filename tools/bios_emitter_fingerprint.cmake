# One cross-platform BIOS fingerprint: target sources, recursive local includes,
# cycle headers and recipe inputs. Text CRs are normalized on every host.
cmake_minimum_required(VERSION 3.20)
if(NOT ROOT)
    get_filename_component(ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
endif()
# Macro arguments are reparsed by CMake: normalize native Windows separators first.
file(TO_CMAKE_PATH "${ROOT}" ROOT)
if(NOT PROFILE)
    set(PROFILE "bios/SCPH1001.toml")
endif()
get_filename_component(PROFILE "${PROFILE}" ABSOLUTE BASE_DIR "${ROOT}")
set(_paths)
set(_kinds)
macro(fp_add kind path)
    list(APPEND _paths "${path}")
    list(APPEND _kinds "${kind}")
endmacro()
if(FP_HAND_LIST)
    foreach(_f IN ITEMS full_function_emitter.cpp full_function_emitter.h
        strict_translator.cpp main_bios.cpp function_discovery.cpp bios_address_model.cpp
        bios_address_model.h config_loader.cpp control_flow.cpp function_analysis.cpp
        mips_decoder.cpp bios_slice_walker.cpp basic_block.cpp)
        fp_add(hand "${ROOT}/recompiler/src/${_f}")
    endforeach()
    fp_add(hand "${ROOT}/runtime/include/psx_cyc.h")
    fp_add(hand "${ROOT}/runtime/include/psx_instr_cost.h")
elseif(EXISTS "${ROOT}/recompiler/CMakeLists.txt")
    file(READ "${ROOT}/recompiler/CMakeLists.txt" _cmake)
    string(REGEX REPLACE "#[^\n]*" "" _cmake "${_cmake}")
    string(REGEX MATCH "add_executable[ \t\r\n]*\\([ \t\r\n]*psxrecomp-bios[ \t\r\n]+([^)]*)\\)" _target "${_cmake}")
    if(NOT _target)
        message(FATAL_ERROR "bios_emitter_fingerprint: cannot read psxrecomp-bios target")
    endif()
    set(_source_text "${CMAKE_MATCH_1}")
    if(_source_text MATCHES "[$<>]")
        message(FATAL_ERROR "bios_emitter_fingerprint: target requires unresolved CMake expansion")
    endif()
    separate_arguments(_sources UNIX_COMMAND "${_source_text}")
    set(_queue)
    foreach(_src IN LISTS _sources)
        get_filename_component(_src "${_src}" ABSOLUTE BASE_DIR "${ROOT}/recompiler")
        if(NOT EXISTS "${_src}")
            message(FATAL_ERROR "bios_emitter_fingerprint: missing source ${_src}")
        endif()
        fp_add(source "${_src}")
        list(APPEND _queue "${_src}")
    endforeach()
    set(_seen "${_queue}")
    set(_headers)
    while(_queue)
        list(POP_FRONT _queue _file)
        get_filename_component(_dir "${_file}" DIRECTORY)
        file(STRINGS "${_file}" _includes REGEX "^[ \t]*#[ \t]*include[ \t]*\"")
        foreach(_line IN LISTS _includes)
            string(REGEX MATCH "include[ \t]*\"([^\"]+)\"" _match "${_line}")
            set(_name "${CMAKE_MATCH_1}")
            foreach(_base IN ITEMS "${_dir}" "${ROOT}/recompiler/include" "${ROOT}/recompiler/src")
                get_filename_component(_inc "${_name}" ABSOLUTE BASE_DIR "${_base}")
                file(RELATIVE_PATH _rel "${ROOT}" "${_inc}")
                if(NOT _rel MATCHES "^\\.\\." AND EXISTS "${_inc}")
                    if(NOT _inc IN_LIST _seen)
                        list(APPEND _seen "${_inc}")
                        list(APPEND _headers "${_inc}")
                        list(APPEND _queue "${_inc}")
                    endif()
                    break()
                endif()
            endforeach()
        endforeach()
    endwhile()
    list(SORT _headers)
    foreach(_header IN LISTS _headers)
        fp_add(header "${_header}")
    endforeach()
    fp_add(extra "${ROOT}/runtime/include/psx_cyc.h")
    fp_add(extra "${ROOT}/runtime/include/psx_instr_cost.h")
endif()
fp_add(profile "${PROFILE}")
if(EXISTS "${PROFILE}")
    file(READ "${PROFILE}" _recipe)
    foreach(_key IN ITEMS seeds rom)
        string(REGEX MATCH "(^|\n)[ \t]*${_key}[ \t]*=[ \t]*\"([^\"]+)\"" _line "${_recipe}")
        set(_value "${CMAKE_MATCH_2}")
        # A pinned ROM is verified by the emitter; CI need not possess it.
        if(_key STREQUAL "rom" AND NOT FP_HAND_LIST AND _recipe MATCHES "(^|\n)[ \t]*sha256[ \t]*=[ \t]*\"[0-9a-fA-F]+\"")
            continue()
        endif()
        if(_value)
            get_filename_component(_input "${_value}" ABSOLUTE BASE_DIR "${ROOT}")
            if(_key STREQUAL "rom")
                set(_rom_input "${_input}")
            endif()
            fp_add(profile "${_input}")
        endif()
    endforeach()
else()
    fp_add(profile "${ROOT}/recompiler/seeds/phase2_ghidra_seeds.json")
endif()
set(_listing "")
set(_inventory "")
list(LENGTH _paths _count)
math(EXPR _last "${_count}-1")
foreach(_i RANGE 0 ${_last})
    list(GET _paths ${_i} _p)
    list(GET _kinds ${_i} _kind)
    file(RELATIVE_PATH _rel "${ROOT}" "${_p}")
    if(EXISTS "${_p}")
        string(APPEND _inventory "${_kind}\tpresent\t${_rel}\n")
        if(FP_HAND_LIST OR _p STREQUAL _rom_input)
            file(SHA256 "${_p}" _d)
        else()
            file(READ "${_p}" _content)
            string(REPLACE "\r" "" _content "${_content}")
            string(SHA256 _d "${_content}")
        endif()
        if(FP_DEBUG)
            message("${_d}  ${_rel}")
        endif()
        string(APPEND _listing "${_d}  -\n")
    else()
        string(APPEND _inventory "${_kind}\tabsent\t${_rel}\n")
    endif()
endforeach()
if(FP_LIST)
    string(STRIP "${_inventory}" _output)
else()
    string(SHA256 _output "${_listing}")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" -E echo "${_output}")
