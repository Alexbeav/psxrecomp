# PS1B-434 regression test, run as: cmake -DTEST_NAME=<its ctest name> -P check_test_temp.cmake
# Passes only when ctest gave this test its own TEMP, TMP and TMPDIR: one folder
# <build>/tt/<n> that exists and that tt/index.txt names for this test.
cmake_minimum_required(VERSION 3.20)
set(_own "")
foreach(_var IN ITEMS TEMP TMP TMPDIR)
    set(_value "$ENV{${_var}}")
    file(TO_CMAKE_PATH "${_value}" _value)
    if(NOT _value MATCHES "/tt/([0-9]+)$")
        message(FATAL_ERROR "${_var} is '${_value}', not a test's own tt/<n> folder")
    endif()
    if(_own STREQUAL "")
        set(_own "${_value}")
        set(_n "${CMAKE_MATCH_1}")
    elseif(NOT _value STREQUAL _own)
        message(FATAL_ERROR "${_var} is '${_value}', not the same folder as TEMP '${_own}'")
    endif()
endforeach()
if(NOT IS_DIRECTORY "${_own}")
    message(FATAL_ERROR "TEMP folder '${_own}' does not exist")
endif()
get_filename_component(_root "${_own}" DIRECTORY)
file(STRINGS "${_root}/index.txt" _line REGEX "^${_n} ")
if(NOT _line STREQUAL "${_n} ${TEST_NAME}")
    message(FATAL_ERROR "tt/index.txt gives folder ${_n} to '${_line}', not to ${TEST_NAME}")
endif()
message(STATUS "PASS: TEMP, TMP and TMPDIR are this test's own folder tt/${_n}")
