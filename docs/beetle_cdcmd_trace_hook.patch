@@ -511,6 +511,7 @@ FrontIO *PSX_FIO = NULL;
 /* PSXRecomp oracle hooks: NULL when no listener attached. */
 psxrecomp_wtrace_cb_t  g_psxrecomp_wtrace_cb  = NULL;
 psxrecomp_fntrace_cb_t g_psxrecomp_fntrace_cb = NULL;
+psxrecomp_cdcmd_cb_t   g_psxrecomp_cdcmd_cb   = NULL;
 
 MultiAccessSizeMem<512 * 1024, uint32, false> *BIOSROM = NULL;
