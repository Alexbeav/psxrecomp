diff --git a/mednafen/psx/psx.h b/mednafen/psx/psx.h
index 05122c8c..0e61795d 100644
--- a/mednafen/psx/psx.h
+++ b/mednafen/psx/psx.h
@@ -198,4 +198,24 @@ extern psxrecomp_rtrace_cb_t g_psxrecomp_rtrace_cb;
 typedef void (*psxrecomp_irq_cb_t)(int which);
 extern psxrecomp_irq_cb_t g_psxrecomp_irq_cb;
 
+/* PSXRecomp oracle: absolute guest CPU clock. psxrecomp_guest_cycle_base is
+ * the sum of the CPU timestamps of every completed retro_run() frame since
+ * the last power-on (timestamps restart at 0 each frame), so inside a frame
+ * the absolute guest cycle of an instruction is base + the CPU's running
+ * timestamp. beetle_core_get_guest_cycles() returns the base, i.e. the exact
+ * clock between frames, where the debug server samples it. */
+extern uint64_t psxrecomp_guest_cycle_base;
+extern "C" unsigned long long beetle_core_get_guest_cycles(void);
+
+/* PSXRecomp oracle: per-instruction PC hook (drives the cyc_watch
+ * comparator). Fired by PS_CPU::RunReal before EVERY instruction fetch,
+ * i.e. before any cycle of that instruction (fetch, execute, stalls) is
+ * charged.
+ *   pc           = guest PC about to be fetched
+ *   guest_cycles = absolute guest cycles charged for all prior instructions
+ * NULL (the default) costs one predicted-not-taken branch per instruction;
+ * the listener should install it only while a watch is armed. */
+typedef void (*psxrecomp_pc_cb_t)(uint32_t pc, uint64_t guest_cycles);
+extern psxrecomp_pc_cb_t g_psxrecomp_pc_cb;
+
 #endif
