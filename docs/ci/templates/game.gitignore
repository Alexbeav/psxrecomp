# Suggested .gitignore for a PSXRecomp game repository.
# Copy to the game repo root and adjust title-specific disc dirs.

# Build outputs
/build/
/build-*/
/out/
/.happypath/

# Release packaging
/release-stage/
/dist/
*.zip

# Local PlayStation assets (never commit)
/bios/
/isos/
/saves/
/prepared_disc/
# Title disc working trees (rename to match your layout, e.g. /bpe/ /motk/)
/disc/

# Disc / image / memcard formats
*.bin
*.cue
*.iso
*.img
*.sub
*.ccd
*.mcd
*.mcr
*.chd

# Ghidra / local analysis
/ghidra/projects/
*.gpr
*.rep/
*.lock
*.lock~

# Editor / cache
.vs/
.vscode/
*.user
*.log
__pycache__/

# Runtime artifacts from psx-runtime launches
psx_crash.txt
psx_last_run_report.json
psx_screenshot.bmp
psx_freeze_heartbeat.json
starvation_dump.jsonl
disc.cfg

# Diagnostic dumps (root-level)
/*.json
/*.bmp
/*.png

# Setup-host titles: leave generated/ gitignored (users generate locally).
# Titles that still CI-build from committed game C may track generated/ instead.
/generated/
