diff --git a/mednafen/psx/irq.cpp b/mednafen/psx/irq.cpp
index 029b9f84..d99dbbb3 100644
--- a/mednafen/psx/irq.cpp
+++ b/mednafen/psx/irq.cpp
@@ -73,6 +73,10 @@ void IRQ_Assert(int which, bool status)
       Asserted |= 1 << which;
       //Status |= 1 << which;
       Status |= (old_Asserted ^ Asserted) & Asserted;
+
+      /* PSXRecomp oracle hook: rising edge of this IRQ line. */
+      if(MDFN_UNLIKELY(g_psxrecomp_irq_cb) && ((old_Asserted ^ Asserted) & Asserted))
+         g_psxrecomp_irq_cb(which);
    }
 
    Recalc();
diff --git a/mednafen/psx/psx.h b/mednafen/psx/psx.h
index fc53362d..05122c8c 100644
--- a/mednafen/psx/psx.h
+++ b/mednafen/psx/psx.h
@@ -178,4 +178,24 @@ typedef void (*psxrecomp_cdcmd_cb_t)(uint8_t cmd, uint8_t nargs,
                                       uint32_t pc);
 extern psxrecomp_cdcmd_cb_t g_psxrecomp_cdcmd_cb;
 
+/* PSXRecomp oracle: CPU load (read) trace callback — the read-side twin of
+ * the wtrace hook. Fired by PS_CPU after LB/LBU/LH/LHU/LW/LWL/LWR/LWC2 read
+ * memory (not on an address-error exception).
+ *   addr  = virtual address of the access (LWL/LWR: the unaligned address)
+ *   value = loaded bus value, zero-extended to `size` bytes
+ *           (LWL/LWR: the merged register value, size 4)
+ *   pc    = PC of the executing load instruction
+ *   ra    = $ra (GPR[31]) at time of load
+ *   size  = 1, 2, or 4 */
+typedef void (*psxrecomp_rtrace_cb_t)(uint32_t addr, uint32_t value,
+                                       uint32_t pc, uint32_t ra, uint8_t size);
+extern psxrecomp_rtrace_cb_t g_psxrecomp_rtrace_cb;
+
+/* PSXRecomp oracle: interrupt-line rising-edge callback. Fired by
+ * IRQ_Assert() when source `which` (the I_STAT bit number: 0=VBLANK,
+ * 2=CD, 3=DMA, ...) goes from deasserted to asserted, i.e. exactly when
+ * the I_STAT bit latches. */
+typedef void (*psxrecomp_irq_cb_t)(int which);
+extern psxrecomp_irq_cb_t g_psxrecomp_irq_cb;
+
 #endif
